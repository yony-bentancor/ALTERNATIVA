{
  "name": "alternativa",
  "version": "1.0.0",
  "private": true,
  "description": "Alternativa — marketplace de especialistas en terapias, bienestar y disciplinas alternativas (Uruguay).",
  "main": "src/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node scripts/seed.js",
    "jobs": "node scripts/jobs.js",
    "create-admin": "node scripts/create-admin.js",
    "indexes": "node scripts/sync-indexes.js",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint src scripts test public/js public/sw.js",
    "vapid": "node scripts/vapid.js",
    "seed:demo": "node scripts/seed.js --demo",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "connect-mongo": "^5.1.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "eslint": "^9.17.0"
  }
}
