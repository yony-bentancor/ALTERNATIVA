<%- include('../partials/head') %>
<%- include('../partials/encabezado', { t: 'Mensajes' }) %>
<% if (!lista.length) { %><%- include('../partials/vacio', { t: 'No tenés mensajes', texto: 'Cuando alguien te escriba desde tu ficha, lo vas a ver acá.', ic: 'chat' }) %><% } %>
<ul class="list panel">
  <% lista.forEach(c => { const u = usuarios.get(c.usuarioId); %>
  <li><a class="list-row" href="/panel/mensajes/<%= c.id %>">
    <% if (u && u.avatar) { %><img class="avatar avatar--md" src="<%= u.avatar %>" alt=""><% } else { %><span class="avatar avatar--md avatar--initial"><%= (u ? u.nombre : '?')[0] %></span><% } %>
    <div class="list-row__main"><p class="list-row__title<%= c.sinLeerEspecialista ? ' conv-unread' : '' %>"><%= u ? u.nombre : 'Usuario' %></p><p class="list-row__sub truncate"><%= c.vistaPrevia || 'Conversación nueva' %></p></div>
    <span class="small muted"><%= fRelativa(c.ultimoMensaje) %></span><% if (c.sinLeerEspecialista) { %><span class="pill pill--brand"><%= c.sinLeerEspecialista %></span><% } %>
  </a></li>
  <% }) %>
</ul>
<%- include('../partials/pie') %>
