<%- include('../partials/head') %>
<% const u = d.ubicacion || {}; const cats = [].concat(d.categorias || []); const mods = [].concat(d.modalidades || []); const val = (k) => d[k] ?? ''; %>
<%- include('../partials/encabezado', { t: editando ? 'Editar ficha' : 'Nueva ficha', sub: editando ? d.nombre : 'Cargá el perfil de un especialista que todavía no tiene cuenta. Después lo invitás a reclamarlo.', volver: editando ? '/admin/especialistas/' + editando : '/admin/especialistas' }) %>
<% if (errores.length) { %><div class="flash flash--error" role="alert"><%- icono('alert', { tam: 18 }) %><span><%= errores.join(' ') %></span></div><% } %>
<form class="stack-lg" method="post" action="<%= editando ? '/admin/especialistas/' + editando : '/admin/especialistas' %>" style="max-width:820px">
  <%- include('../partials/csrf') %>
  <section class="panel stack"><h2>Perfil</h2>
    <div class="grid-2">
      <div class="field"><label for="f-n">Nombre profesional</label><input id="f-n" name="nombre" value="<%= val('nombre') %>" required maxlength="120"></div>
      <div class="field"><label for="f-t">Titular</label><input id="f-t" name="titular" value="<%= val('titular') %>" maxlength="160" placeholder="Masajista terapéutica con 10 años de experiencia"></div>
    </div>
    <div class="field"><label for="f-b">Sobre mí</label><textarea id="f-b" name="bio" rows="5" maxlength="4000"><%= val('bio') %></textarea></div>
    <div class="grid-2">
      <div class="field"><label for="f-e">Experiencia</label><textarea id="f-e" name="experiencia" rows="3"><%= val('experiencia') %></textarea></div>
      <div class="field"><label for="f-f">Formación</label><textarea id="f-f" name="formacion" rows="3"><%= val('formacion') %></textarea></div>
      <div class="field"><label for="f-a">Años de experiencia</label><input id="f-a" name="anios" type="number" min="0" max="80" value="<%= val('anios') %>"></div>
      <div class="field"><label for="f-i">Idiomas (separados por coma)</label><input id="f-i" name="idiomas" value="<%= [].concat(d.idiomas || []).join(', ') %>"></div>
    </div>
    <fieldset class="field"><legend>Categorías</legend><div class="row"><% categorias.forEach(c => { %><label class="check"><input type="checkbox" name="categorias" value="<%= c.id %>"<%= cats.includes(c.id) ? ' checked' : '' %>> <%= c.nombre %><%= c.estado !== 'activa' ? ' (' + c.estado + ')' : '' %></label><% }) %></div></fieldset>
    <fieldset class="field"><legend>Modalidades</legend><div class="row"><% Object.entries(MODALIDADES).forEach(([k, m]) => { %><label class="check"><input type="checkbox" name="modalidades" value="<%= k %>"<%= mods.includes(k) ? ' checked' : '' %>> <%= m.texto %></label><% }) %></div></fieldset>
  </section>
  <section class="panel stack"><h2>Ubicación</h2>
    <div class="grid-2">
      <div class="field"><label for="f-d">Departamento</label><select id="f-d" name="departamento"><option value="">—</option><% DEPARTAMENTOS.forEach(x => { %><option<%= (u.departamento || d.departamento) === x ? ' selected' : '' %>><%= x %></option><% }) %></select></div>
      <div class="field"><label for="f-c">Ciudad</label><input id="f-c" name="ciudad" value="<%= u.ciudad || '' %>"></div>
      <div class="field"><label for="f-ba">Barrio</label><input id="f-ba" name="barrio" value="<%= u.barrio || '' %>"></div>
      <div class="field"><label for="f-di">Dirección (privada hasta reservar)</label><input id="f-di" name="direccion" value="<%= u.direccion || '' %>"></div>
      <div class="field"><label for="f-r">Referencia pública</label><input id="f-r" name="referencia" value="<%= u.referencia || '' %>" placeholder="A dos cuadras de la rambla"></div>
      <div class="field"><label for="f-rk">Radio a domicilio (km)</label><input id="f-rk" name="radioKm" type="number" min="0" max="200" value="<%= u.radioKm ?? 10 %>"></div>
      <div class="field"><label for="f-la">Latitud</label><input id="f-la" name="lat" value="<%= u.lat ?? '' %>" placeholder="-34.9055"></div>
      <div class="field"><label for="f-lo">Longitud</label><input id="f-lo" name="lng" value="<%= u.lng ?? '' %>" placeholder="-56.1550"></div>
    </div>
    <p class="field__hint">Las coordenadas son opcionales: sin ellas el mapa usa la dirección o el barrio.</p>
  </section>
  <section class="panel stack"><h2>Contacto y redes</h2>
    <div class="grid-2">
      <div class="field"><label for="f-te">Teléfono (privado)</label><input id="f-te" name="telefono" value="<%= val('telefono') %>"></div>
      <div class="field"><label for="f-w">WhatsApp</label><input id="f-w" name="whatsapp" value="<%= val('whatsapp') %>" placeholder="099 123 456"></div>
      <div class="field"><label for="f-ig">Instagram</label><input id="f-ig" name="instagram" value="<%= d.redes?.instagram || d.instagram || '' %>"></div>
      <div class="field"><label for="f-web">Sitio web</label><input id="f-web" name="web" value="<%= d.redes?.web || d.web || '' %>"></div>
    </div>
    <label class="check"><input type="checkbox" name="mostrarWhatsapp" value="1"<%= d.mostrarWhatsapp ? ' checked' : '' %>> Mostrar botón de WhatsApp en la ficha (según la política de contacto)</label>
  </section>
  <section class="panel stack"><h2>Condiciones comerciales</h2>
    <div class="grid-2">
      <div class="field"><label for="f-co">Comisión propia (%)</label><input id="f-co" name="comision" type="number" step="0.1" min="0" max="50" value="<%= d.comision ?? '' %>" placeholder="Vacío = reglas generales"><p class="field__hint">Pisa la comisión general y las reglas por categoría. Aplica solo a reservas nuevas.</p></div>
      <div class="field"><label for="f-p">Plan</label><select id="f-p" name="plan"><option value="gratis">Gratis</option><option value="profesional"<%= d.plan === 'profesional' ? ' selected' : '' %>>Profesional</option></select></div>
      <div class="field"><label for="f-pv">Plan vence</label><input id="f-pv" name="planVence" type="date" value="<%= d.planVence ? String(d.planVence).slice(0, 10) : '' %>"></div>
    </div>
  </section>
  <div class="row"><button class="btn btn--primary" type="submit"><%= editando ? 'Guardar cambios' : 'Crear ficha' %></button><a class="btn btn--ghost" href="<%= editando ? '/admin/especialistas/' + editando : '/admin/especialistas' %>">Cancelar</a></div>
</form>
<%- include('../partials/pie') %>
