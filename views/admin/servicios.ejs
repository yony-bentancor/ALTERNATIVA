<%- include('../partials/head') %>
<% const EST = { activo: ['Publicado', 'ok'], pausado: ['Pausado', ''], en_revision: ['En revisión', 'warn'], suspendido: ['Suspendido', 'danger'] }; %>
<%- include('../partials/encabezado', { t: 'Servicios', sub: p.total + ' servicios' }) %>
<form class="toolbar">
  <div class="field"><input type="search" name="q" value="<%= query.q || '' %>" placeholder="Buscar servicio" aria-label="Buscar"></div>
  <div class="field"><select name="estado" aria-label="Estado"><option value="">Todos los estados</option><% Object.entries(EST).forEach(([k, [t]]) => { %><option value="<%= k %>"<%= query.estado === k ? ' selected' : '' %>><%= t %></option><% }) %></select></div>
  <div class="field"><select name="categoria" aria-label="Categoría"><option value="">Todas las categorías</option><% categorias.forEach(c => { %><option value="<%= c.id %>"<%= query.categoria === c.id ? ' selected' : '' %>><%= c.nombre %></option><% }) %></select></div>
  <% if (query.especialista) { %><input type="hidden" name="especialista" value="<%= query.especialista %>"><% } %>
  <button class="btn btn--ghost btn--sm" type="submit">Filtrar</button>
</form>
<div class="table-wrap"><table class="table">
  <thead><tr><th>Servicio</th><th>Especialista</th><th>Categoría</th><th class="num">Precio</th><th>Estado</th><th class="num">Reservas</th><th class="num">Valoración</th></tr></thead>
  <tbody><% p.items.forEach(s => { const e = espMap.get(s.especialistaId); %><tr>
    <td><div class="row" style="flex-wrap:nowrap"><% if ((s.fotos || [])[0]) { %><img class="mini-thumb" src="<%= s.fotos[0] %>" alt=""><% } %><a href="/admin/servicios/<%= s.id %>"><%= s.titulo %></a></div></td>
    <td class="small"><% if (e) { %><a href="/admin/especialistas/<%= e.id %>"><%= e.nombre %></a><% } %></td>
    <td class="small"><%= catMap.get(s.categoriaId)?.nombre %></td><td class="num"><%= pesos(s.precio) %></td>
    <td><%- include('../partials/pill', { texto: EST[s.estado][0], tono: EST[s.estado][1] }) %></td>
    <td class="num"><%= (s.stats || {}).reservas || 0 %></td><td class="num"><%= s.rating && s.rating.cant ? '★ ' + fRating(s.rating.prom) + ' (' + s.rating.cant + ')' : '—' %></td>
  </tr><% }) %></tbody>
</table></div>
<%- include('../partials/paginacion', { p }) %>
<%- include('../partials/pie') %>
