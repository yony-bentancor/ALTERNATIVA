# ─── General ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# URL pública sin barra final (se usa en emails, SEO, Mercado Pago y webhooks)
APP_URL=http://localhost:3000
# Etiqueta de entorno visible en el panel admin: development | staging | production
APP_ENV=development
TZ_NAME=America/Montevideo

# ─── Base de datos (MongoDB Atlas u otro gestionado en producción) ──
MONGODB_URI=mongodb://127.0.0.1:27017/alternativa

# ─── Sesiones ─────────────────────────────────────────────
# Cadena larga y aleatoria. Ej: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambiar-esto-por-una-cadena-larga-y-aleatoria

# ─── Primer administrador (scripts/create-admin.js) ────────
ADMIN_EMAIL=admin@alternativa.uy
ADMIN_PASSWORD=

# ─── Pagos ─────────────────────────────────────────────────
# simulated: checkout de prueba (solo desarrollo/staging) | mercadopago
PAYMENT_PROVIDER=simulated
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Clave secreta de webhooks (Mercado Pago → Tus integraciones → Webhooks)
MP_WEBHOOK_SECRET=
# Para el modelo mixto (split): credenciales de la aplicación de Mercado Pago (OAuth)
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# ─── Archivos multimedia ──────────────────────────────────
# local: guarda en public/uploads (solo desarrollo, el disco de Heroku es efímero) | cloudinary
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=alternativa

# ─── Email ─────────────────────────────────────────────────
# console: imprime en logs | resend
EMAIL_PROVIDER=console
EMAIL_FROM="Alternativa <hola@alternativa.uy>"
RESEND_API_KEY=

# ─── Notificaciones push (Web Push / VAPID) ───────────────
# Generar con: npm run vapid  (o node scripts/vapid.js)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@alternativa.uy

# ─── WhatsApp (Meta Cloud API, opcional) ──────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=es

# ─── Automatizaciones ─────────────────────────────────────
# true: corre los jobs dentro del proceso web cada 5 min. En Heroku se recomienda
# false + Heroku Scheduler ejecutando "npm run jobs" cada 10 minutos.
RUN_JOBS_IN_PROCESS=true
