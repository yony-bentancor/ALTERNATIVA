# ─────────────────────────────────────────────────────────────
#  Alternativa — variables de entorno
#  Copiá este archivo como .env para trabajar en tu computadora.
#  En Heroku se cargan en Settings → Config Vars.
#  Todas son opcionales: sin .env el sistema arranca en modo demostración.
# ─────────────────────────────────────────────────────────────

# ─── General ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# desarrollo | staging | production   ("production" = dinero real: bloquea la pasarela simulada)
APP_ENV=desarrollo
# URL pública sin barra final (emails, Mercado Pago, webhooks, SEO)
APP_URL=http://localhost:3000
TZ_NAME=America/Montevideo
# Cadena larga y aleatoria: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambiar-esto-por-una-cadena-larga-y-aleatoria

# ─── Datos ───────────────────────────────────────────────────
# Archivo JSON donde se guardan los datos (si no existe se genera con los datos de prueba)
# DATA_FILE=./data/db.json
# MongoDB (todavía no activo; ver config/db.js)
USAR_MONGO=false
MONGODB_URI=

# ─── Demostración ────────────────────────────────────────────
# true: muestra los usuarios de prueba en /ingresar y el aviso de "sitio de demostración"
MODO_DEMO=true
# Contraseña de todos los usuarios de prueba
CLAVE_DEMO=alternativa2026

# ─── Pagos ───────────────────────────────────────────────────
# simulado: checkout de prueba sin dinero real | mercadopago
PAYMENT_PROVIDER=simulado
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Clave secreta de webhooks (Mercado Pago → Tus integraciones → Webhooks)
MP_WEBHOOK_SECRET=
# Credenciales de la aplicación (OAuth) para que cada especialista vincule su cuenta (split)
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# ─── Email ───────────────────────────────────────────────────
# consola: no envía, se ven en Administración → Avisos | resend
EMAIL_PROVIDER=consola
EMAIL_FROM=Alternativa <hola@alternativa.uy>
RESEND_API_KEY=

# ─── WhatsApp automático (opcional, Meta Cloud API) ─────────
# Sin esto igual funcionan los botones de WhatsApp (enlaces wa.me)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=es

# ─── Notificaciones push (generar con: npm run vapid) ───────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@alternativa.uy

# ─── Google Maps (opcional) ─────────────────────────────────
# Sin clave se usa el mapa público embebido de Google; con clave, la API oficial Maps Embed
GOOGLE_MAPS_API_KEY=

# ─── Tareas automáticas ─────────────────────────────────────
# Cada cuántos minutos se vencen reservas impagas, se envían recordatorios, etc.
JOBS_EVERY_MINUTES=5
